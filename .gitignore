# Результаты сборки лежат в output/ и не версионируются — см. output/.gitignore.
# Они полностью воспроизводятся командой `python src/build.py`.

# Python
__pycache__/
*.py[cod]
*.pyo

# Виртуальные окружения (проекту не нужны, но на случай локальных экспериментов)
.venv/
venv/
env/

